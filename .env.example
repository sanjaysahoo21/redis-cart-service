# =============================================================
# Redis Cart Service — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values before running locally.
# When using docker-compose.yml, most of these are already set
# in the 'environment:' section of the app service.
# =============================================================

# ----- Redis Connection -----
# Hostname of the Redis server.
# Use 'redis' inside Docker Compose (matches the service name).
# Use 'localhost' when running the Spring Boot app directly.
SPRING_REDIS_HOST=redis

# Port Redis listens on (default: 6379)
SPRING_REDIS_PORT=6379

# Redis password — must match the 'requirepass' value set on the Redis server.
# Change this to a strong secret value in production!
REDIS_PASSWORD=changeme

# ----- Spring Application -----
# The name of the Spring Boot application (optional, used in logs/actuator)
SPRING_APPLICATION_NAME=redis-cart-service

# ----- Server Configuration -----
# Port the embedded Tomcat server listens on (default: 8080)
SERVER_PORT=8080

# ----- Cart Configuration -----
# Time-To-Live for each cart in Redis, in minutes (default: 30)
CART_TTL_MINUTES=30

# ----- Actuator / Management -----
# Username for HTTP Basic Auth to access /actuator/** endpoints
# Change this to a strong credential in production!
ACTUATOR_USER=admin

# Password for HTTP Basic Auth to access /actuator/** endpoints
# Change this to a strong credential in production!
ACTUATOR_PASSWORD=actuatorPass123

# ----- Logging -----
# Log level for the application package (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_COM_EXAMPLE_REDISCARTSERVICE=INFO
